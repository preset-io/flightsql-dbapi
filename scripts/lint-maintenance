#!/usr/bin/env bash

set -euo pipefail

grep -Eq '^[^#[:space:]].*[[:space:]]+@[-A-Za-z0-9_/]+([[:space:]]|$)' CODEOWNERS
grep -Fq '**Owning organization:**' MAINTENANCE.md
grep -Fq '**Maintenance function:**' MAINTENANCE.md
grep -Fq '**Current maintenance coordinator:**' MAINTENANCE.md
grep -Fq '**GitHub assignment status:**' MAINTENANCE.md
cmp -s flightsql/provenance.py scripts/verify-installed-provenance
! grep -Eq 'TBD|DRI placeholder|assign the DRI|Primary DRI and CODEOWNER' CODEOWNERS MAINTENANCE.md
